  _content: "\uC0AC\uB839\uAD00\uB2D8.\n\uC694\uC998 \uC194\uC838 \uB300\uC6D0\uC758
    \uC804\uD22C\uB825 \uBCF4\uAC15\uC774 \uD544\uC694\uD574\uBCF4\uC785\uB2C8\uB2E4.\n\uC194\uC838
    \uB300\uC6D0\uC758 \uC804\uD22C\uB97C \uB3C4\uC640\uC8FC\uC2E4 \uC218 \uC788\uC73C\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?\n\uC194\uC838
    \uB300\uC6D0\uC758 \uC804\uD22C\uB808\uBCA8\uC744 5\uC815\uB3C4\uAE4C\uC9C0\uB9CC
    \uC62C\uB9B4 \uC218 \uC788\uB2E4\uBA74 \uB3C4\uC6C0\uC774 \uB420 \uAC83 \uC785\uB2C8\uB2E4."
  _lines:
  - _text: "\uC0AC\uB839\uAD00\uB2D8."
  - _text: "\uC694\uC998 \uC194\uC838 \uB300\uC6D0\uC758 \uC804\uD22C\uB825 \uBCF4\uAC15\uC774
      \uD544\uC694\uD574\uBCF4\uC785\uB2C8\uB2E4."
  - _text: "\uC194\uC838 \uB300\uC6D0\uC758 \uC804\uD22C\uB97C \uB3C4\uC640\uC8FC\uC2E4
      \uC218 \uC788\uC73C\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?"
  - _text: "\uC194\uC838 \uB300\uC6D0\uC758 \uC804\uD22C\uB808\uBCA8\uC744 5\uC815\uB3C4\uAE4C\uC9C0\uB9CC
      \uC62C\uB9B4 \uC218 \uC788\uB2E4\uBA74 \uB3C4\uC6C0\uC774 \uB420 \uAC83 \uC785\uB2C8\uB2E4."
