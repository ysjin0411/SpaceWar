  _id: Shop_Default
  _requiredFlags: []
  _hidingFlags: []
  _priority: 0
  _content: "\uC548\uB155\uD558\uC2ED\uB2C8\uAE4C \uC0AC\uB839\uAD00\uB2D8.\n\uC800\uB294
    \uC804\uD22C\uC5D0 \uC0AC\uC6A9\uD560 \uBB34\uAE30\uB4E4\uC744 \uAD00\uB9AC\uD558\uACE0
    \uC788\uC2B5\uB2C8\uB2E4.\n\uC800\uB97C \uD1B5\uD574 \uC0C8\uB85C\uC6B4 \uBB34\uAE30\uB97C
    \uC0B4 \uC218\uB3C4, \uAE30\uC874 \uBB34\uAE30\uB97C \uAD50\uCCB4\uD560 \uC218\uB3C4
    \uC788\uC2B5\uB2C8\uB2E4!\n\uBB3C\uB860, \uAD6C\uB9E4\uC5D0\uB294 \uBE44\uC6A9\uC774
    \uB530\uB985\uB2C8\uB2E4.\n\uC0AC\uB839\uAD00\uB2D8\uC774\uC5EC\uB3C4 \uC5B4\uCA54
    \uC218 \uC5C6\uC5B4\uC694."
  _lines:
  - _text: "\uC548\uB155\uD558\uC2ED\uB2C8\uAE4C \uC0AC\uB839\uAD00\uB2D8."
  - _text: "\uC800\uB294 \uC804\uD22C\uC5D0 \uC0AC\uC6A9\uD560 \uBB34\uAE30\uB4E4\uC744
      \uAD00\uB9AC\uD558\uACE0 \uC788\uC2B5\uB2C8\uB2E4."
  - _text: "\uC800\uB97C \uD1B5\uD574 \uC0C8\uB85C\uC6B4 \uBB34\uAE30\uB97C \uC0B4
      \uC218\uB3C4, \uAE30\uC874 \uBB34\uAE30\uB97C \uAD50\uCCB4\uD560 \uC218\uB3C4
      \uC788\uC2B5\uB2C8\uB2E4!"
  - _text: "\uBB3C\uB860, \uAD6C\uB9E4\uC5D0\uB294 \uBE44\uC6A9\uC774 \uB530\uB985\uB2C8\uB2E4."
  - _text: "\uC0AC\uB839\uAD00\uB2D8\uC774\uC5EC\uB3C4 \uC5B4\uCA54 \uC218 \uC5C6\uC5B4\uC694."
