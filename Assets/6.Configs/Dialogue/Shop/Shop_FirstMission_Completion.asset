  _id: shop_first_mission_completion
  _requiredFlags: []
  _hidingFlags: []
  _priority: 0
  _content: "\uC548\uB155\uD558\uC2ED\uB2C8\uAE4C \uC0AC\uB839\uAD00\uB2D8.\n\uC194\uC838
    \uB300\uC6D0\uC740 \uC218\uB958\uD0C4\uC744 \uC798 \uBC1B\uC558\uB2F5\uB2C8\uAE4C?\n\uC624\uC624,
    \uADF8\uB807\uAD70\uC694.\n\uC194\uC838\uAC00 \uC544\uC8FC \uAE30\uBED0\uD558\uACA0\uC2B5\uB2C8\uB2E4.\n\uC774\uAC74,
    \uC81C \uBCF4\uB2F5\uC785\uB2C8\uB2E4."
  _lines:
  - _text: "\uC548\uB155?"
  - _text: "Stage 1 \uC740 \uD074\uB9AC\uC5B4\uD558\uACE0 \uC628\uAC70\uC57C?"
  - _text: "\uC624, \uC815\uB9D0 Stage 1\uC744 \uD074\uB9AC\uC5B4\uD558\uACE0 \uC654\uB124!"
  - _text: "\uACE0\uB9C8\uC6CC, \uB355\uBD84\uC5D0 \uC880 \uC7A0\uC7A0\uD574\uC9C0\uACA0\uC5B4."
  - _text: "\uC5EC\uAE30, \uC774\uAC74 \uB0B4 \uACE0\uB9C8\uC6C0\uC758 \uD45C\uC2DC\uC57C."
